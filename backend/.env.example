# --- App ---
APP_NAME=AI-Powered Intelligent E-Learning Platform
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENV=development

# --- Database ---
# Default: local SQLite file, zero setup.
DATABASE_URL=sqlite:///./elearning.db
# To use PostgreSQL instead, set e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/elearning

# --- LLM Provider ---
# Options: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama settings (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embeddings ---
# Options: "local" (sentence-transformers, free, offline) or "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_db

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
